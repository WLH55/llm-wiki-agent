# 复制为 .env.dev / .env.prod / .env.test 后按需修改
#
# 两种运行模式（地址不同，见下方注释）：
#   1) 本机开发（默认）：docker-compose.dev.yml 只起基础设施（postgres/redis/minio），
#      backend 在本机运行 -> 把地址改为 localhost（.env.dev 已改好，模板保留容器服务名）
#   2) 容器部署：docker-compose.yml 通过 env_file 注入 .env.prod -> 保持服务名地址

# ========== 环境（dev / prod / test）==========
ENVIRONMENT=dev
DEBUG=true
APP_NAME=LLM Wiki 3.0
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ========== 日志（容器内路径；compose 挂载到宿主机 ./storage/logs/backend）==========
LOGS_DIR=/app/logs
STORAGE_DIR=/app/storage

# ========== Postgres ==========
# 容器部署：postgres:5432；本机开发：localhost:5432（端口见 docker-compose.dev.yml DB_PORT）
POSTGRES_DSN=postgresql+asyncpg://llmwiki:llmwiki@postgres:5432/llmwiki

# ========== Redis ==========
# 容器部署：redis:6379；本机开发：localhost:6380（避免与宿主机 Redis 冲突）
# 密码与 docker-compose(.dev).yml 的 REDIS_PASSWORD 保持一致
REDIS_URL=redis://:llmwiki@redis:6379/0

# ========== MinIO ==========
# 容器部署：minio:9000；本机开发：localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=llmwiki
MINIO_SECRET_KEY=llmwiki123
MINIO_BUCKET=llm-wiki
MINIO_SECURE=false

# ========== JWT ==========
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ========== Bootstrap owner ==========
BOOTSTRAP_OWNER_EMAIL=owner@local
BOOTSTRAP_OWNER_PASSWORD=change-me

# ========== Embedding（Jina / OpenAI 兼容协议）==========
EMBEDDING_API_BASE=https://api.jina.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIM=1024

# ========== Parser ==========
# 50 MiB = 50 * 1024 * 1024 bytes
PARSER_MAX_FILE_BYTES=52428800
PARSER_MAX_OUTPUT_CHARS=5000000
# 20 MiB = 20 * 1024 * 1024 bytes
PARSER_MAX_TOTAL_IMAGE_BYTES=20971520
PARSER_TIMEOUT_SECONDS=300

# ========== RAG ==========
RAG_TOP_K_EACH=20
RAG_RRF_K=60
