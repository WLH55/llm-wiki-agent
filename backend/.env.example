# 复制为 .env.dev / .env.prod / .env.test 后按需修改
# Docker 开发：改 backend/.env.dev 后执行
#   docker compose --profile app up -d
# 或
#   docker compose --profile app restart backend worker
# 指定环境：
#   ENVIRONMENT=prod docker compose --profile app up -d

# ========== 环境（dev / prod / test）==========
ENVIRONMENT=dev
DEBUG=true
APP_NAME=LLM Wiki 3.0
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ========== 日志（容器内路径；compose 挂载到宿主机 ./storage/logs/backend）==========
LOGS_DIR=/app/logs
STORAGE_DIR=/app/storage

# ========== Postgres ==========
# Docker 网络内用服务名 postgres；本机直连可改为 localhost
POSTGRES_DSN=postgresql+asyncpg://llmwiki:llmwiki@postgres:5432/llmwiki

# ========== Redis ==========
# 容器间始终用 redis:6379；宿主机映射为 localhost:6380
REDIS_URL=redis://redis:6379/0

# ========== MinIO ==========
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=llmwiki
MINIO_SECRET_KEY=llmwiki123
MINIO_BUCKET=llm-wiki
MINIO_SECURE=false

# ========== JWT ==========
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ========== Bootstrap owner ==========
BOOTSTRAP_OWNER_EMAIL=owner@local
BOOTSTRAP_OWNER_PASSWORD=change-me

# ========== Embedding（Jina / OpenAI 兼容协议）==========
EMBEDDING_API_BASE=https://api.jina.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIM=1024

# ========== Parser ==========
# 50 MiB = 50 * 1024 * 1024 bytes
PARSER_MAX_FILE_BYTES=52428800
PARSER_MAX_OUTPUT_CHARS=5000000
# 20 MiB = 20 * 1024 * 1024 bytes
PARSER_MAX_TOTAL_IMAGE_BYTES=20971520
PARSER_TIMEOUT_SECONDS=300

# ========== RAG ==========
RAG_TOP_K_EACH=20
RAG_RRF_K=60
