# =============================================================================
# LLM Wiki Agent - Docker Compose 环境变量示例
# -----------------------------------------------------------------------------
# 用法：
#   1. 复制为 .env：cp .env.example .env
#   2. 按需修改端口/凭据；应用业务配置在 backend/.env.{dev,prod,test}
#   3. 确保 .env 不会被提交到版本库
#
# 注入机制：
#   - docker-compose.yml（生产）用本文件做变量插值，并通过
#     env_file 把 backend/.env.prod 注入 backend / task-worker
#   - docker-compose.dev.yml（开发）只启动基础设施（参考 WeKnora dev 模式），
#     backend/frontend 本机运行，连接地址见 backend/.env.dev（localhost）
# =============================================================================

# 运行环境：dev | prod | test（决定加载 backend/.env.*）
ENVIRONMENT=dev

# ========== 端口映射（宿主机:容器） ==========
# 生产与开发默认端口相同，两套同时跑时在 .env 改端口
DB_PORT=5432
REDIS_PORT=6379        # 开发 compose 默认 6380（避免与宿主机 Redis 冲突）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8008
FRONTEND_PORT=80       # 生产 nginx；开发前端固定 5173

# ========== 镜像与构建 ==========
# 镜像版本标签（backend/frontend/postgres 共用）
LLM_WIKI_VERSION=latest
POSTGRES_TAG=pg16-zhparser
# apt 镜像源（如 mirrors.aliyun.com / mirrors.tuna.tsinghua.edu.cn），留空用官方源
APT_MIRROR_ARG=
# pip 镜像源（如 https://mirrors.aliyun.com/pypi/simple/），留空用官方源
PIP_INDEX_ARG=
# Playwright 浏览器下载源（默认 npmmirror，国内加速）
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
# 构建信息注入（可选）
# COMMIT_ID=
# BUILD_TIME=

# ========== 基础设施凭据 ==========
# 生产环境务必修改下列默认值，并与 backend/.env.prod 保持一致
POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=llmwiki
POSTGRES_DB=llmwiki
# 需同步 backend/.env.{dev,prod,test} 的 REDIS_URL 密码段
REDIS_PASSWORD=llmwiki
MINIO_ROOT_USER=llmwiki
MINIO_ROOT_PASSWORD=llmwiki123

# ========== 前端运行时（nginx 反代） ==========
# nginx 反代后端地址：容器内走服务名 backend；远程部署改为公网地址
APP_HOST=backend
APP_BACKEND_PORT=8008
APP_SCHEME=http
# 上传大小上限（MB），与后端 PARSER_MAX_FILE_BYTES=50MiB 对齐
MAX_FILE_SIZE_MB=50

# ========== 其他 ==========
TZ=Asia/Shanghai
