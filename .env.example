# ========== 环境配置 ==========
ENVIRONMENT=development

# ========== Postgres ==========
POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=llmwiki
POSTGRES_DB=llmwiki

# ========== MinIO ==========
MINIO_ROOT_USER=llmwiki
MINIO_ROOT_PASSWORD=llmwiki123
MINIO_BUCKET=llm-wiki

# ========== JWT (HS256, 24h) ==========
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_HOURS=24

# ========== Bootstrap owner ==========
BOOTSTRAP_OWNER_EMAIL=owner@local
BOOTSTRAP_OWNER_PASSWORD=change-me

# ========== Embedding (SiliconFlow bge-m3) ==========
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
